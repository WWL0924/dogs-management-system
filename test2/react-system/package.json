{
  "name": "react-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mock": "json-server --port 4000 db.json",
    "server": "node --experimental-strip-types src/server/index.ts",
    "server:dev": "node --watch --experimental-strip-types src/server/index.ts",
    "server:check": "tsc --project tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "antd": "^6.2.2",
    "dayjs": "^1.11.19",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "immer": "^11.1.3",
    "jose": "^6.2.18",
    "mysql2": "^3.24.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "json-server": "^1.0.0-beta.9",
    "less": "^4.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-compression": "^0.5.1"
  }
}
